# Apache: envia tudo que não for arquivo existente para o index.php
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bloqueia arquivos ocultos (.git, .env etc.)
    RewriteRule (^|/)\. - [F,L]
    # O único PHP executável é o index.php; qualquer outro .php enviado aqui é recusado.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} !/public/index\.php$
    RewriteRule \.(php\d?|phtml|phar|pl|py|cgi|sh)$ - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>
